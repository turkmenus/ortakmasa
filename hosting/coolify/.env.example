# -----------------------------------------------------------------------------
# Ortakmasa - Coolify & S3 Deployment Environment Variables
# -----------------------------------------------------------------------------

# Web & Domain Settings
APP_DOMAIN=ortakmasa.192.168.1.101.nip.io
APP_PROTOCOL=https
WEB_PORT=80

# PostgreSQL (pgvector)
POSTGRES_USER=colanode_user
POSTGRES_PASSWORD=generate_a_secure_postgres_password
POSTGRES_DB=colanode_db
# POSTGRES_URL=postgres://colanode_user:password@postgres:5432/colanode_db

# Valkey / Redis
REDIS_PASSWORD=generate_a_secure_valkey_password
# REDIS_URL=redis://:password@valkey:6379/0

# -----------------------------------------------------------------------------
# Object Storage (S3 / MinIO / Cloudflare R2 / AWS S3)
# -----------------------------------------------------------------------------
# Seçenek 1: Coolify içi dahili MinIO (varsayılan)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=generate_a_secure_minio_password
S3_BUCKET=ortakmasa
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Seçenek 2: Cloudflare R2 kullanmak isterseniz:
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
# S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
# S3_BUCKET=ortakmasa
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false

# Seçenek 3: AWS S3 kullanmak isterseniz:
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_ACCESS_KEY=<AWS_ACCESS_KEY_ID>
# S3_SECRET_KEY=<AWS_SECRET_ACCESS_KEY>
# S3_BUCKET=ortakmasa
# S3_REGION=eu-central-1
# S3_FORCE_PATH_STYLE=false
